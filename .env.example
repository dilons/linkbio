# Copie para .env.local e preencha. Nunca ponha valores neste arquivo.
# Local: `npm run db:start` imprime as chaves do Supabase local (são padrões
# públicos do Supabase CLI, só servem na sua máquina).

# --- Supabase (Settings > API Keys e Settings > Database no painel)
NEXT_PUBLIC_SUPABASE_URL=
# chave publicável (sb_publishable_...): vai para o navegador, só faz login
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# chave secreta (sb_secret_...): só no servidor. Excluir usuário e Storage.
SUPABASE_SECRET_KEY=
# Postgres. Na Vercel, a string do pooler de transação (porta 6543).
DATABASE_URL=
DATABASE_POOL_MAX=

# --- Endereço público do app (links dos emails e da cobrança)
NEXT_PUBLIC_SITE_URL=

# --- Login com Google (app OAuth do linkbio no Google Cloud; configurado no Supabase)
NEXT_PUBLIC_LOGIN_GOOGLE=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Asaas (sandbox até a /replica-deploy)
# https://api-sandbox.asaas.com/v3 (sandbox) ou https://api.asaas.com/v3 (produção)
ASAAS_API_URL=
ASAAS_API_KEY=
# o mesmo token cadastrado no webhook do Asaas (chega no cabeçalho asaas-access-token)
ASAAS_WEBHOOK_TOKEN=
# preço do Pro em centavos (provisório: 1900)
PRECO_PRO_CENTAVOS=

# --- Email do app (Resend, do domínio próprio). Sem a chave, vai para o MAILPIT_URL.
RESEND_API_KEY=
EMAIL_FROM=
# só em desenvolvimento: o Mailpit do Supabase local (http://127.0.0.1:54324)
MAILPIT_URL=

# --- Jobs (Vercel Cron manda este segredo no cabeçalho Authorization)
CRON_SECRET=
